<!-- Ebox -->
<link name="Ebox_link">
    <inertial>
        <origin xyz="-.8 -0.31 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
    <visual name="">
        <origin xyz="-.8 -0.31 0.0" rpy="-1.571 0 -1.571"/>
        <geometry>
            <mesh filename="package://amiga_description/meshes/Ebox/Ebox.obj" scale="1.0 1.0 1.0"/>
        </geometry>
        <material name="black">
            <color rgba=".0 .0 0.0 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <geometry>
            <mesh filename="package://amiga_description/meshes/Ebox/Ebox.obj" scale="1.0 1.0 1.0"/>
        </geometry>
    </collision>
</link>

<joint name="Ebox_joint" type="fixed">
    <origin xyz="0.0 0.0 0.05" rpy="0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="Ebox_link"/>
    <axis xyz="0.0 0.0 0.0"/>
</joint>
<!-- </xacro:macro> -->
<ros2_control name="GazeboSystem" type="system">

  <hardware>
    <xacro:if value="$(arg is_sim)">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </xacro:if>
  </hardware>
  <joint name="tire_front_left_joint">
        <command_interface name="velocity">
          <param name="min">-100</param>
          <param name="max">100</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="tire_rear_left_joint">
        <command_interface name="velocity">
          <param name="min">-100</param>
          <param name="max">100</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="tire_front_right_joint">
        <command_interface name="velocity">
          <param name="min">-100</param>
          <param name="max">100</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="tire_rear_right_joint">
        <command_interface name="velocity">
          <param name="min">-100</param>
          <param name="max">100</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
</ros2_control>
</robot>
