<?xml version="1.0"?>
<package format="3">
  <name>amiga_gazebo</name>
  <version>1.0.9</version>
  <description>Amiga ROS2 simulation</description>

  <author email="ruijil@andrew.cmu.edu">Ruiji Liu</author>
  <maintainer email="ruijil@andrew.cmu.edu">Ruiji Liu</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <depend>xacro</depend>

  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>amiga_control</exec_depend>
  <exec_depend>amiga_description</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <depend>lidar_rowdetect</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
